<script>
  (function () {
    const rawVercelJson = `{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}`;

    const copyBtn = document.getElementById('btn-copy-code');
    const copyLabel = document.getElementById('copy-btn-label');
    const cliBtn = document.getElementById('copy-cli-btn');
    const cliIcon = document.getElementById('cli-copy-icon');
    const downloadBtn = document.getElementById('btn-download-json');
    const testSchemaBtn = document.getElementById('btn-preview-schema');

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(rawVercelJson).then(() => {
          if (copyLabel) copyLabel.textContent = 'COPIED TO CLIPBOARD!';
          copyBtn.classList.add('bg-primary-container', 'text-on-primary-container');
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = '1-Click Copy Code';
            copyBtn.classList.remove('bg-primary-container', 'text-on-primary-container');
          }, 2200);
        });
      });
    }

    if (cliBtn) {
      cliBtn.addEventListener('click', function () {
        navigator.clipboard.writeText('npm i -g vercel && vercel').then(() => {
          if (cliIcon) cliIcon.textContent = 'done';
          setTimeout(() => {
            if (cliIcon) cliIcon.textContent = 'content_copy';
          }, 1800);
        });
      });
    }

    if (downloadBtn) {
      downloadBtn.addEventListener('click', function () {
        const blob = new Blob([rawVercelJson], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'vercel.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    if (testSchemaBtn) {
      testSchemaBtn.addEventListener('click', function () {
        const originalText = testSchemaBtn.textContent;
        testSchemaBtn.textContent = 'Checking Vercel API...';
        testSchemaBtn.disabled = true;
        setTimeout(() => {
          testSchemaBtn.textContent = 'Passed (200 OK)';
          setTimeout(() => {
            testSchemaBtn.textContent = originalText;
            testSchemaBtn.disabled = false;
          }, 1500);
        }, 600);
      });
    }
  })();
</script></main></div></body></html>
