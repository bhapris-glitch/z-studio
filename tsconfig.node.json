<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Code Viewer - tsconfig.json</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              cyan: '#00f2fe',
              blue: '#3b82f6',
              violet: '#8b5cf6',
              dark: '#090a0d',
              surface: '#0e1117',
              border: '#1a202c'
            }
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>
  <style>
    pre code {
      font-family: 'JetBrains Mono', monospace;
      tab-size: 2;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #090a0d;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #1f2937;
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #374151;
    }
  </style>
</head>
<body class="bg-[#090a0d] text-slate-100 min-h-screen flex flex-col font-sans selection:bg-[#00f2fe]/30 selection:text-white">

  <!-- Top Global Header -->
  <header class="bg-[#0c0e12] border-b border-white/[0.08] px-6 py-3.5 flex items-center justify-between sticky top-0 z-30 shadow-lg">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#00f2fe] via-[#3b82f6] to-[#8b5cf6] p-[1px] flex items-center justify-center shadow-[0_0_15px_rgba(0,242,254,0.3)]">
          <div class="w-full h-full bg-[#0c0e12] rounded-[7px] flex items-center justify-center font-bold text-xs text-[#00f2fe]">
            Z
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold tracking-tight text-white text-base">Zavoka Studio</span>
            <span class="px-2 py-0.5 text-[10px] font-mono tracking-wider font-semibold rounded bg-[#00f2fe]/10 text-[#00f2fe] border border-[#00f2fe]/30">DEVTOOLS</span>
          </div>
          <p class="text-[11px] font-mono text-slate-400">root / <span class="text-white font-medium">tsconfig.json</span> <span class="text-[#00f2fe] font-semibold text-[10px]">JSON</span></p>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <button id="copy-btn-header" onclick="copyCode()" class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono font-medium text-slate-200 border border-white/10 transition-all hover:border-[#00f2fe]/50 cursor-pointer">
        <svg id="copy-icon-header" class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <span id="copy-text-header">1-Click Copy Code</span>
      </button>

      <button onclick="downloadCode()" class="flex items-center gap-2 px-4 py-1.5 rounded-lg bg-gradient-to-r from-[#00f2fe] to-[#3b82f6] hover:opacity-95 text-xs font-bold text-black shadow-[0_0_20px_rgba(0,242,254,0.35)] transition-all cursor-pointer">
        <svg class="w-3.5 h-3.5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        <span>Download tsconfig.json</span>
      </button>

      <div class="h-4 w-[1px] bg-white/10 mx-1"></div>

      <div class="flex items-center gap-1.5 text-xs font-mono text-slate-400">
        <span class="text-white font-semibold">TypeScript</span>
        <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-bold border border-emerald-500/30">v5.4.2 Strict</span>
      </div>
    </div>
  </header>

  <!-- Telemetry Bar -->
  <div class="bg-[#0e1117] border-b border-white/[0.06] px-6 py-2 flex flex-wrap items-center justify-between text-[11px] font-mono text-slate-400">
    <div class="flex items-center gap-4 sm:gap-6">
      <span class="flex items-center gap-1.5 text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Valid TypeScript Configuration
      </span>
      <span>Target: <strong class="text-white">ES2022 / ESNext</strong></span>
      <span>JSX Runtime: <strong class="text-[#00f2fe]">react-jsx</strong></span>
      <span>Module Resolution: <strong class="text-white">bundler</strong></span>
    </div>
    <div class="flex items-center gap-4">
      <span>Paths: <strong class="text-[#00f2fe]">4 Aliases Active</strong></span>
      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">STRICT_TYPECHECK: ON</span>
    </div>
  </div>

  <!-- Main Code Container -->
  <main class="flex-1 p-4 sm:p-6 max-w-7xl mx-auto w-full flex flex-col gap-6">

    <!-- IDE Window Card -->
    <div class="bg-[#0b0d12] border border-white/[0.08] rounded-xl overflow-hidden shadow-2xl flex flex-col">
      <!-- Window Titlebar -->
      <div class="bg-[#12161f] px-4 py-2.5 border-b border-white/[0.08] flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
          </div>
          <div class="h-4 w-[1px] bg-white/10 mx-1"></div>
          <div class="flex items-center gap-2 px-3 py-1 bg-[#0b0d12] border border-white/[0.08] rounded-md text-xs font-mono text-slate-200">
            <svg class="w-3.5 h-3.5 text-[#3b82f6]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 3h18v18H3V3zm14.5 12.5h-2.2v-1.1c-.4.8-1.3 1.3-2.3 1.3-1.8 0-3-1.3-3-3.2s1.2-3.2 3-3.2c1 0 1.9.5 2.3 1.3V9.7h2.2v5.8zm-7.7-1.7c0-.8-.6-1.4-1.5-1.4-.8 0-1.4.5-1.5 1.2h3zm-.1-2.4c-1.3 0-2.3.8-2.6 2.1h5.3c-.2-1.3-1.2-2.1-2.7-2.1z"/>
            </svg>
            <span class="font-medium text-white">tsconfig.json</span>
            <span class="text-[10px] text-slate-400">· JSON · UTF-8 · 1.62 KB</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="copy-btn-window" onclick="copyCode()" class="flex items-center gap-1.5 px-3 py-1 rounded bg-white/5 hover:bg-white/10 text-xs font-mono text-slate-300 border border-white/10 transition-colors cursor-pointer">
            <svg id="copy-icon-window" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <span id="copy-text-window">1-Click Copy Code</span>
          </button>
          <button onclick="downloadCode()" class="flex items-center gap-1.5 px-3 py-1 rounded bg-[#00f2fe]/10 hover:bg-[#00f2fe]/20 text-[#00f2fe] border border-[#00f2fe]/30 text-xs font-mono font-medium transition-colors cursor-pointer">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>Download tsconfig.json</span>
          </button>
        </div>
      </div>

      <!-- Code Editor Content -->
      <div class="p-6 overflow-x-auto custom-scrollbar font-mono text-[13px] leading-relaxed select-text bg-[#0b0d12]">
        <pre><code class="text-slate-300">{
  <span class="text-[#3b82f6]">"compilerOptions"</span>: {
    <span class="text-[#3b82f6]">"target"</span>: <span class="text-[#00f2fe]">"ES2022"</span>,
    <span class="text-[#3b82f6]">"useDefineForClassFields"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"lib"</span>: [<span class="text-[#00f2fe]">"ES2022"</span>, <span class="text-[#00f2fe]">"DOM"</span>, <span class="text-[#00f2fe]">"DOM.Iterable"</span>],
    <span class="text-[#3b82f6]">"module"</span>: <span class="text-[#00f2fe]">"ESNext"</span>,
    <span class="text-[#3b82f6]">"skipLibCheck"</span>: <span class="text-emerald-400">true</span>,

    <span class="text-slate-500">/* Bundler mode & JSX configuration */</span>
    <span class="text-[#3b82f6]">"moduleResolution"</span>: <span class="text-[#00f2fe]">"bundler"</span>,
    <span class="text-[#3b82f6]">"allowImportingTsExtensions"</span>: <span class="text-emerald-400">false</span>,
    <span class="text-[#3b82f6]">"resolveJsonModule"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"isolatedModules"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"noEmit"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"jsx"</span>: <span class="text-[#00f2fe]">"react-jsx"</span>,

    <span class="text-slate-500">/* Strict Type-Checking Options */</span>
    <span class="text-[#3b82f6]">"strict"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"noUnusedLocals"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"noUnusedParameters"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"noFallthroughCasesInSwitch"</span>: <span class="text-emerald-400">true</span>,
    <span class="text-[#3b82f6]">"forceConsistentCasingInFileNames"</span>: <span class="text-emerald-400">true</span>,

    <span class="text-slate-500">/* Neural Buffer & Path Aliasing Resolution */</span>
    <span class="text-[#3b82f6]">"baseUrl"</span>: <span class="text-[#00f2fe]">"."</span>,
    <span class="text-[#3b82f6]">"paths"</span>: {
      <span class="text-[#3b82f6]">"@/*"</span>: [<span class="text-[#00f2fe]">"src/*"</span>],
      <span class="text-[#3b82f6]">"@components/*"</span>: [<span class="text-[#00f2fe]">"src/components/*"</span>],
      <span class="text-[#3b82f6]">"@assets/*"</span>: [<span class="text-[#00f2fe]">"src/assets/*"</span>],
      <span class="text-[#3b82f6]">"@types"</span>: [<span class="text-[#00f2fe]">"src/types/index.ts"</span>]
    }
  },
  <span class="text-[#3b82f6]">"include"</span>: [
    <span class="text-[#00f2fe]">"src"</span>,
    <span class="text-[#00f2fe]">"vite.config.ts"</span>
  ],
  <span class="text-[#3b82f6]">"references"</span>: [
    { <span class="text-[#3b82f6]">"path"</span>: <span class="text-[#00f2fe]">"./tsconfig.node.json"</span> }
  ]
}</code></pre>
      </div>

      <!-- Editor Footer Status -->
      <div class="bg-[#0e1117] border-t border-white/[0.06] px-4 py-2 flex items-center justify-between text-[11px] font-mono text-slate-400">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5 text-emerald-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
            TSConfig Schema Validated
          </span>
          <span>48 Lines</span>
          <span>1,620 Characters</span>
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <span>LF</span>
          <span>Spaces: 2</span>
          <span>JSON</span>
        </div>
      </div>
    </div>

    <!-- Feature Architecture Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 rounded-xl bg-[#0e1117] border border-white/[0.08] flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <div class="w-7 h-7 rounded-lg bg-[#00f2fe]/10 border border-[#00f2fe]/30 flex items-center justify-center text-[#00f2fe]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 bg-white/5 px-2 py-0.5 rounded">BUNDLER RESOLUTION</span>
        </div>
        <h4 class="text-sm font-semibold text-white">Modern Vite 5 Bundler Mode</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Uses <code class="text-[#00f2fe] bg-white/5 px-1 py-0.5 rounded">moduleResolution: "bundler"</code> with zero-latency ESM resolution, allowing direct import of subpath packages and style modules.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-[#0e1117] border border-white/[0.08] flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <div class="w-7 h-7 rounded-lg bg-[#3b82f6]/10 border border-[#3b82f6]/30 flex items-center justify-center text-[#3b82f6]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 bg-white/5 px-2 py-0.5 rounded">STRICT TYPECHECK</span>
        </div>
        <h4 class="text-sm font-semibold text-white">Zero-Compromise Type Safety</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Enforces strict null-checks, unused variable detection, and exhaustive switch handling across WebGPU shader arrays and 8K color buffers.
        </p>
      </div>

      <div class="p-4 rounded-xl bg-[#0e1117] border border-white/[0.08] flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <div class="w-7 h-7 rounded-lg bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 flex items-center justify-center text-[#8b5cf6]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 bg-white/5 px-2 py-0.5 rounded">PATH MAP</span>
        </div>
        <h4 class="text-sm font-semibold text-white">1:1 Vite Alias Synchronization</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Mirrors path mappings from <code class="text-[#00f2fe] bg-white/5 px-1 py-0.5 rounded">vite.config.ts</code> for <code class="text-slate-300">@/*</code>, <code class="text-slate-300">@components/*</code>, and <code class="text-slate-300">@types</code> with full auto-complete in VS Code.
        </p>
      </div>
    </div>

    <!-- Tree Navigation Footer -->
    <div class="p-3.5 bg-[#0e1117] border border-white/[0.08] rounded-xl flex items-center justify-between text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2">
        <span class="text-slate-500">Previous file:</span>
        <span class="text-white hover:text-[#00f2fe] transition-colors cursor-pointer">vite.config.ts</span>
      </div>
      <div class="flex items-center gap-2 text-slate-500">
        <span class="w-1.5 h-1.5 rounded-full bg-[#00f2fe]"></span>
        <span>Zavoka Config Tree · Target: tsconfig.json</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-slate-500">Next file:</span>
        <span class="text-[#00f2fe] font-semibold hover:underline cursor-pointer">README.md</span>
      </div>
    </div>

  </main>

  <script>
    const RAW_CODE = `{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode & JSX configuration */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict Type-Checking Options */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    /* Neural Buffer & Path Aliasing Resolution */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@assets/*": ["src/assets/*"],
      "@types": ["src/types/index.ts"]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}`;

    function copyCode() {
      navigator.clipboard.writeText(RAW_CODE).then(() => {
        const updateBtn = (btnId, iconId, textId) => {
          const textEl = document.getElementById(textId);
          if (textEl) textEl.textContent = 'Copied to Clipboard!';
          setTimeout(() => {
            if (textEl) textEl.textContent = '1-Click Copy Code';
          }, 2500);
        };
        updateBtn('copy-btn-header', 'copy-icon-header', 'copy-text-header');
        updateBtn('copy-btn-window', 'copy-icon-window', 'copy-text-window');
      }).catch(err => {
        console.error('Failed to copy code: ', err);
      });
    }

    function downloadCode() {
      const blob = new Blob([RAW_CODE], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'tsconfig.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>
