<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Code Viewer - package.json</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    pre, code, .font-mono { font-family: 'JetBrains Mono', monospace; }
    .custom-scrollbar::-webkit-scrollbar { width: 8px; height: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #0c0e12; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #262930; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #3b3f49; }
  </style>
</head>
<body class="bg-[#090a0d] text-white min-h-screen flex flex-col selection:bg-[#00f2fe]/30 selection:text-white">

  <!-- Top App Navigation / Code Viewer Header -->
  <header class="bg-[#0c0e12]/90 backdrop-blur-xl border-b border-white/10 sticky top-0 z-50 px-4 sm:px-8 py-3.5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#00f2fe]/20 via-[#00f2fe]/10 to-transparent border border-[#00f2fe]/30 flex items-center justify-center text-[#00f2fe] font-black text-base shadow-[0_0_15px_rgba(0,242,254,0.15)]">
          Z
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-extrabold text-sm tracking-tight text-white">Zavoka Studio</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-[#00f2fe]/10 text-[#00f2fe] border border-[#00f2fe]/30">VITE ROOT</span>
          </div>
          <p class="text-[11px] font-mono text-slate-400">root / <span class="text-white font-semibold">package.json</span></p>
        </div>
      </div>
    </div>

    <!-- Actions: Copy & Download -->
    <div class="flex items-center gap-3">
      <button id="copy-btn" onclick="copyCode()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-slate-200 transition-all cursor-pointer hover:border-white/20 active:scale-95">
        <svg id="copy-icon" class="w-4 h-4 text-[#00f2fe]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span id="copy-text">1-Click Copy Code</span>
      </button>

      <button onclick="downloadFile()" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-[#00f2fe] to-[#38bdf8] hover:brightness-110 text-[#090a0d] text-xs font-extrabold shadow-[0_0_20px_rgba(0,242,254,0.3)] transition-all cursor-pointer active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>Download package.json</span>
      </button>
    </div>
  </header>

  <!-- Telemetry Subheader -->
  <div class="bg-[#0e1015] border-b border-white/5 px-4 sm:px-8 py-2.5 flex flex-wrap items-center justify-between text-xs font-mono text-slate-400 gap-4">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Valid JSON Specification
      </span>
      <span>•</span>
      <span>Lines: <strong class="text-white">46 lines</strong></span>
      <span>•</span>
      <span>Package Manager: <strong class="text-[#00f2fe]">pnpm / npm / yarn</strong></span>
      <span>•</span>
      <span>Engine: <strong class="text-slate-300">Node.js &gt;= 18.0.0</strong></span>
    </div>
    <div class="flex items-center gap-3 text-[11px]">
      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">Vite 5.x</span>
      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">React 18.2</span>
      <span class="px-2 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300">TypeScript 5.4</span>
    </div>
  </div>

  <!-- Main Code Canvas Viewport -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-6">
    <div class="bg-[#0b0d12] border border-white/10 rounded-2xl shadow-2xl overflow-hidden flex flex-col">
      <!-- Window Titlebar -->
      <div class="bg-[#12151b] px-4 py-3 border-b border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
          <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
          <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
          <div class="ml-3 flex items-center gap-2 px-3 py-1 rounded-md bg-[#090a0d] border border-white/5 text-xs font-mono text-[#00f2fe]">
            <svg class="w-3.5 h-3.5 text-[#00f2fe]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            package.json
          </div>
        </div>
        <div class="text-[11px] font-mono text-slate-400">
          JSON • UTF-8 • 1.34 KB
        </div>
      </div>

      <!-- Syntax Highlighted Code Viewer -->
      <div class="p-6 overflow-x-auto custom-scrollbar font-mono text-xs sm:text-sm leading-relaxed text-slate-300">
        <pre><code id="code-content">{
  <span class="text-[#38bdf8]">"name"</span>: <span class="text-[#2dd4bf]">"zavoka-studio"</span>,
  <span class="text-[#38bdf8]">"private"</span>: <span class="text-[#f59e0b]">true</span>,
  <span class="text-[#38bdf8]">"version"</span>: <span class="text-[#2dd4bf]">"2.4.0"</span>,
  <span class="text-[#38bdf8]">"type"</span>: <span class="text-[#2dd4bf]">"module"</span>,
  <span class="text-[#38bdf8]">"description"</span>: <span class="text-[#2dd4bf]">"Zavoka Studio - 8K Neural Image, Super-Resolution & 3D Product Staging Engine"</span>,
  <span class="text-[#38bdf8]">"scripts"</span>: {
    <span class="text-[#38bdf8]">"dev"</span>: <span class="text-[#2dd4bf]">"vite"</span>,
    <span class="text-[#38bdf8]">"build"</span>: <span class="text-[#2dd4bf]">"tsc && vite build"</span>,
    <span class="text-[#38bdf8]">"preview"</span>: <span class="text-[#2dd4bf]">"vite preview"</span>,
    <span class="text-[#38bdf8]">"lint"</span>: <span class="text-[#2dd4bf]">"eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"</span>
  },
  <span class="text-[#38bdf8]">"dependencies"</span>: {
    <span class="text-[#38bdf8]">"react"</span>: <span class="text-[#2dd4bf]">"^18.2.0"</span>,
    <span class="text-[#38bdf8]">"react-dom"</span>: <span class="text-[#2dd4bf]">"^18.2.0"</span>,
    <span class="text-[#38bdf8]">"lucide-react"</span>: <span class="text-[#2dd4bf]">"^0.359.0"</span>,
    <span class="text-[#38bdf8]">"clsx"</span>: <span class="text-[#2dd4bf]">"^2.1.0"</span>,
    <span class="text-[#38bdf8]">"tailwind-merge"</span>: <span class="text-[#2dd4bf]">"^2.2.1"</span>
  },
  <span class="text-[#38bdf8]">"devDependencies"</span>: {
    <span class="text-[#38bdf8]">"@types/node"</span>: <span class="text-[#2dd4bf]">"^20.11.24"</span>,
    <span class="text-[#38bdf8]">"@types/react"</span>: <span class="text-[#2dd4bf]">"^18.2.64"</span>,
    <span class="text-[#38bdf8]">"@types/react-dom"</span>: <span class="text-[#2dd4bf]">"^18.2.21"</span>,
    <span class="text-[#38bdf8]">"@vitejs/plugin-react"</span>: <span class="text-[#2dd4bf]">"^4.2.1"</span>,
    <span class="text-[#38bdf8]">"autoprefixer"</span>: <span class="text-[#2dd4bf]">"^10.4.18"</span>,
    <span class="text-[#38bdf8]">"postcss"</span>: <span class="text-[#2dd4bf]">"^8.4.35"</span>,
    <span class="text-[#38bdf8]">"tailwindcss"</span>: <span class="text-[#2dd4bf]">"^3.4.1"</span>,
    <span class="text-[#38bdf8]">"typescript"</span>: <span class="text-[#2dd4bf]">"^5.4.2"</span>,
    <span class="text-[#38bdf8]">"vite"</span>: <span class="text-[#2dd4bf]">"^5.1.5"</span>
  },
  <span class="text-[#38bdf8]">"engines"</span>: {
    <span class="text-[#38bdf8]">"node"</span>: <span class="text-[#2dd4bf]">"&gt;=18.0.0"</span>
  }
}</code></pre>
      </div>
    </div>

    <!-- Feature Spec Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-4 rounded-2xl bg-[#111318] border border-white/5 flex flex-col gap-2">
        <div class="flex items-center gap-2.5 text-xs font-bold text-[#00f2fe]">
          <svg class="w-4 h-4 text-[#00f2fe]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Vite 5 & React 18 Concurrent
        </div>
        <p class="text-xs text-slate-400">Zero-overhead fast HMR with official `@vitejs/plugin-react` bundling for immediate live previewing of 8K renders.</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#111318] border border-white/5 flex flex-col gap-2">
        <div class="flex items-center gap-2.5 text-xs font-bold text-[#38bdf8]">
          <svg class="w-4 h-4 text-[#38bdf8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          Strict TypeScript 5.4 Safety
        </div>
        <p class="text-xs text-slate-400">Full type safety across all RAW codec formats, WebGPU lighting parameters, and ExportLab state machines.</p>
      </div>

      <div class="p-4 rounded-2xl bg-[#111318] border border-white/5 flex flex-col gap-2">
        <div class="flex items-center gap-2.5 text-xs font-bold text-emerald-400">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V7c0-2-1-3-3-3H7C5 4 4 5 4 7z"/>
          </svg>
          Tailwind CSS v3 + Merge
        </div>
        <p class="text-xs text-slate-400">Pre-wired PostCSS and Autoprefixer toolchain for obsidian themes, glow effects, and responsive mobile tabs.</p>
      </div>
    </div>

    <!-- Tree Navigation Link -->
    <div class="flex items-center justify-between py-2 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2">
        <span>Previous file:</span>
        <span class="text-[#00f2fe] font-semibold">index.html</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Next in tree:</span>
        <span class="text-slate-300 font-semibold">vite.config.ts</span>
      </div>
    </div>
  </main>

  <script>
    const rawJson = `{
  "name": "zavoka-studio",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "description": "Zavoka Studio - 8K Neural Image, Super-Resolution & 3D Product Staging Engine",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.359.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}`;

    function copyCode() {
      navigator.clipboard.writeText(rawJson).then(() => {
        const textSpan = document.getElementById('copy-text');
        const oldText = textSpan.innerText;
        textSpan.innerText = 'Copied to Clipboard!';
        textSpan.classList.add('text-emerald-400');
        setTimeout(() => {
          textSpan.innerText = oldText;
          textSpan.classList.remove('text-emerald-400');
        }, 2000);
      });
    }

    function downloadFile() {
      const blob = new Blob([rawJson], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'package.json';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }
  </script>
</body>
</html>
